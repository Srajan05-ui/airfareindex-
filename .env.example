# Backend API Settings
# To use a Cloud Postgres Database (like Neon.tech or Supabase), paste the connection string here:
# Example: postgresql+psycopg2://user:password@ep-cool-butterfly-1234.us-east-2.aws.neon.tech/neondb
DATABASE_URL=

# If DATABASE_URL is left blank, the system will fall back to using the local sqlite:///airfare.db file.
# Note: Render's free tier deletes local files on restart, so you MUST use a Postgres DATABASE_URL for Render!
